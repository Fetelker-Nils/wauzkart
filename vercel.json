{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/download/wauzkart",
      "destination": "/api/index.js"
    },
    {
      "source": "/garage",
      "destination": "/api/index.js"
    },
    {
      "source": "/wiki",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!assets/|style.css|script.js).*)",
      "destination": "/api/index.js"
    }
  ]
}
